#!/usr/bin/env python3
import subprocess
import sys
from PyQt6.QtWidgets import QApplication, QWidget, QVBoxLayout, QPushButton, QLabel, QPlainTextEdit
from PyQt6.QtGui import QIcon
from PyQt6.QtCore import QProcess, Qt

class Window(QWidget):
    def __init__(self):
        super().__init__()

        self.setWindowTitle("ZeraOS Updater")
        self.setWindowIcon(QIcon("/usr/share/icons/zeraos-updater.svg"))
        self.setFixedSize(700, 250)

        win = QVBoxLayout()

        self.Result = QLabel("")
        self.Result.setStyleSheet("font-size: 13px;")
        self.Result.setAlignment(Qt.AlignmentFlag.AlignHCenter)

        self.Update = QPushButton("Update system")
        self.Update.clicked.connect(self.updatesystem)

        self.Terminal = QPlainTextEdit()
        self.Terminal.setReadOnly(True)

        self.Terminal.setStyleSheet("""
    QPlainTextEdit {
        border: none;
        outline: none;
    }
""")

        win.addWidget(self.Terminal)
        win.addWidget(self.Update)
        win.addWidget(self.Result)

        self.setLayout(win)

    def updatesystem (self):
        self.Update.setEnabled(False)
        self.Terminal.clear()
        self.Result.setText("↻ System update. Please do not turn off the program.")

        self.Pacman = QProcess(self)
        self.Pacman.finished.connect(self.updatefinished)
        self.Pacman.readyReadStandardOutput.connect(self.output)
        self.Pacman.readyReadStandardError.connect(self.error)

        self.Pacman.start("pkexec", ["pacman", "-Syyu", "--noconfirm"])

    def updatefinished (self, exitCode, exitStatus):

        if exitCode == 0:
           self.Result.setText("✓ System updates completed successfully.")
           self.Update.setEnabled(True)
        else:
           self.Result.setText("✕ Error during system update.")
           self.Update.setEnabled(True)

    def output(self):
          Output = self.Pacman.readAllStandardOutput().data().decode()
          self.Terminal.insertPlainText(Output)

    def error(self):
          Error = self.Pacman.readAllStandardError().data().decode()
          self.Terminal.appendPlainText(Error)

app = QApplication(sys.argv)
Window = Window()
Window.show()
sys.exit(app.exec())
