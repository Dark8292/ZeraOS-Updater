#!/usr/bin/env python3
import subprocess
import sys
from PyQt6.QtWidgets import QApplication, QWidget, QVBoxLayout, QPushButton, QLabel, QPlainTextEdit, QHBoxLayout
from PyQt6.QtGui import QIcon
from PyQt6.QtCore import QProcess, Qt

class Window(QWidget):
    def __init__(self):
        super().__init__()

        self.setWindowTitle("ZeraOS Updater")
        self.setWindowIcon(QIcon("/usr/share/icons/zeraos-updater.svg"))
        self.setFixedSize(700, 250)

        win = QVBoxLayout()

        self.Progress = QLabel("")
        self.Progress.setStyleSheet("font-size: 13px;")
        self.Progress.setAlignment(Qt.AlignmentFlag.AlignHCenter)

        self.Terminal = QPlainTextEdit()
        self.Terminal.setReadOnly(True)
        self.Terminal.hide()

        self.Terminal.setStyleSheet("""
    QPlainTextEdit {
        border: none;
        outline: none;
    }
""")

        win.addWidget(self.Terminal)
        win.addWidget(self.Progress)

        self.setLayout(win)

        update = QHBoxLayout()

        self.Update = QPushButton("Update system")
        self.Update.clicked.connect(self.updatesystem)

        self.Logs = QPushButton("Show Logs")
        self.Logs.clicked.connect(self.logs)

        update.addWidget(self.Update)
        update.addWidget(self.Logs)

        win.addLayout(update)

    def logs (self):

        if self.Logs.text() == "Hide Logs":
           self.Logs.setText("Show Logs")
           self.Terminal.hide()
           self.Progress.show()
        elif self.Logs.text() == "Show Logs":
           self.Logs.setText("Hide Logs")
           self.Terminal.show()
           self.Progress.hide()

    def updatesystem (self):

        self.Update.setEnabled(False)
        self.Terminal.clear()
        self.Progress.setText("↻ System update \n Please do not turn off the program.")
        self.Progress.setStyleSheet("""
    color: #FFFFF;
""")

        self.Pacman = QProcess(self)
        self.Pacman.finished.connect(self.updatefinished)
        self.Pacman.readyReadStandardOutput.connect(self.output)
        self.Pacman.readyReadStandardError.connect(self.error)

        self.Pacman.start("pkexec", ["pacman", "-Syyu", "--noconfirm"])

    def updatefinished (self, exitCode, exitStatus):

        if exitCode == 0:
           self.Progress.setText("✓ System updates completed successfully.")
           self.Progress.setStyleSheet("""
    color: #00CC66;
""")
           self.Update.setEnabled(True)
        else:
           self.Progress.setText("✕ Error during system update.")
           self.Progress.setStyleSheet("""
    color: #E53935;
""")
           self.Update.setEnabled(True)

    def output (self):
          Output = self.Pacman.readAllStandardOutput().data().decode()
          self.Terminal.insertPlainText(Output)

    def error (self):
          Error = self.Pacman.readAllStandardError().data().decode()
          self.Terminal.appendPlainText(Error)

app = QApplication(sys.argv)
Window = Window()
Window.show()
sys.exit(app.exec())
